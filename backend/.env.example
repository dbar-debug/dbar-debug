# Токен доступу до API (обовʼязково, ≥32 символи). Без нього сервер
# відповідає 503 на всі запити. Той самий токен вводиться в додатку:
# Налаштування → Токен доступу.
# Згенерувати: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# Шлях до файлу КЕП (наприклад: /home/dbar/keys/key.jks)
KEP_FILE_PATH=/path/to/your/key.jks

# Пароль до КЕП-файлу
KEP_PASSWORD=your_password_here
