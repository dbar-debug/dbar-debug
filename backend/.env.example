# Шлях до файлу КЕП (наприклад: /home/dbar/keys/key.jks)
KEP_FILE_PATH=/path/to/your/key.jks

# Пароль до КЕП-файлу
KEP_PASSWORD=your_password_here

# Токен Telegram-бота (видає @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Як часто перевіряти зміни у справах (хвилини)
NOTIFIER_POLL_MINUTES=30
